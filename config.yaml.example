# nekosearch 配置文件（YAML）。复制为 config.yaml 后按需修改。
# 命令行参数（及兼容的环境变量）优先级高于本文件。

# 节点角色：all(默认, 单机全角色) / registry / crawler / indexer / searcher
role: all

# 本节点各服务监听地址
registry_addr: "0.0.0.0:7700"
indexer_addr: "0.0.0.0:7900"
searcher_addr: "0.0.0.0:7800"

# 集群模式下连接远端注册中心的基址
registry_remote: "http://127.0.0.1:7700"

# 集群模式下连接远端索引节点的基址，支持分片与多副本：
#   分片之间用逗号分隔，同一分片的多个副本用竖线分隔。
#   例："http://s0a:7900|http://s0b:7900,http://s1a:7900"
indexer_remote: "http://127.0.0.1:7900"

# 爬虫种子 URL（列表形式，可多个）
seeds:
  - "https://www.rust-lang.org/"

# 最大爬取深度（BFS）
max_depth: 2

# 持久化索引数据目录（sled）。重启不丢数据。
data_dir: "./data"

# 启动时写入内置「编程语言官网」演示文档到索引（Rust/Go/Python/JS/TS/Java/C++…），
# 便于单机开箱即搜、无需外网爬取。也可通过 --seed-demo 强制开启。
# 注意：--role all 且未配置任何 seeds 时会【自动】启用本演示数据；配置了 seeds 则去爬真实网页。
seed_demo: false

# 多注册中心高可用（Phase 5）：对端注册中心基址列表，逗号分隔。
# 例："http://127.0.0.1:7701,http://127.0.0.1:7702"
# 为空表示单机注册中心（无 HA）。各注册中心通过心跳选主，非 leader 把写请求 307 转发到 leader。
peers: []
